#!/bin/sh
# Runs lint and tests before a commit. Installed by scripts/install_hooks.py.
set -e
cd "$(git rev-parse --show-toplevel)" || exit 1

if [ -x .venv/bin/python ]; then
  PY=.venv/bin/python
elif [ -x .venv/Scripts/python.exe ]; then
  PY=.venv/Scripts/python.exe
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  PY=python
fi

exec "$PY" scripts/preflight.py --stage commit
