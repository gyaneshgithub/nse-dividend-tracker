# Copy this file to .env and adjust the values if needed.
# The application also works without a .env file.

PORT=8901
HOST=127.0.0.1

# Storage locations. Relative paths are resolved from the project directory.
DIVIDEND_DB_DIR=./chroma_db
DIVIDEND_DATA_DIR=./data

# Disable ChromaDB's anonymized telemetry.
ANONYMIZED_TELEMETRY=False

# How long upstream dividend responses are cached, in seconds.
# DIVIDEND_CACHE_TTL=21600
